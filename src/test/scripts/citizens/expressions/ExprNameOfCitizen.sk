test "citizen name":
    spawn citizen named "NameTest" at spawn of world "world"
    set {npc::1} to last created citizen
    assert citizen name of {npc::1} is "NameTest" with "was wrong"
    set citizen name of {npc::1} to "Renamed"
    assert citizen name of {npc::1} is "Renamed" with "was wrong"
    delete all npcs
