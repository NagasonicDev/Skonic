test "citizen is owned by player":
    spawn citizen named "test" at spawn of world "world"
    set {npc::1} to last created citizen
    set citizen owner of {npc::1} to "00000000-0000-0000-0000-000000000000"
    assert citizen owner of {npc::1} is "00000000-0000-0000-0000-000000000000" with "was wrong"
    delete all npcs
